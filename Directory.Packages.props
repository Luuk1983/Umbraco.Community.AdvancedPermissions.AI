<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Base package — the AI companion augments it and resolves its services at runtime.
         Real dependency (flows Abstractions transitively for the compile-time contract, so no
         direct Umbraco.Community.AdvancedPermissions.Abstractions reference is needed even
         though it is now a separately published package). Pinned to the v18 line with a PLAIN
         stable upper bound: a "-0" bound packs fine but nuget.org rejects it at push time
         (400 BadRequest: invalid Version: '19.0.0-0'), and the published base package's own
         nuspec uses plain "[18.0.0, 19.0.0)" bounds — that is the proven form.
         The floor is 18.1.0, NOT 18.0.0: the Library element APIs this package now calls
         (IElementNodePermissionService, AdvancedPermissionsConstants.ElementVerbs,
         VerbElementCreateOfType) were introduced in 18.1.0. -->
    <PackageVersion Include="Umbraco.Community.AdvancedPermissions" Version="[18.1.0,19.0.0)" />
    <!-- Umbraco AI — the [AITool] authoring contract. The package references ONLY Umbraco.AI.Core:
         it needs the attributes ([AITool]/[AIToolScope]), IRuntimeContextContributor, and the
         AIRuntimeContextContributors() builder extension — all shipped in Umbraco.AI.Core, which
         also flows the Umbraco.Cms.* contracts transitively. The full Umbraco.AI runtime bundle
         (Startup/Web/Persistence/StaticAssets) is a HOST concern, referenced by the TestSite only.
         Umbraco.AI majors track the CMS major, so 18.0.0 targets Umbraco.Cms 18.x. Capped below 19
         like the base-package pin: an uncapped floor would claim v19 compatibility this
         v18-targeting package cannot honour.
         Agent/providers/Copilot are TestSite-only (manual verification). -->
    <PackageVersion Include="Umbraco.AI.Core" Version="[18.0.0,19.0.0)" />
    <PackageVersion Include="Umbraco.AI" Version="18.3.1" />
    <PackageVersion Include="Umbraco.AI.Agent" Version="18.1.4" />
    <PackageVersion Include="Umbraco.AI.Agent.Copilot" Version="18.0.5" />
    <PackageVersion Include="Umbraco.AI.Anthropic" Version="18.1.0" />
    <PackageVersion Include="Umbraco.AI.OpenAI" Version="18.2.0" />
    <!-- Umbraco CMS meta — TestSite only (CPM requires a version for the direct reference). The
         package project declares NO direct Umbraco.Cms.* references — they flow transitively, and the
         real floor is computed from the dependencies' nuspecs: Umbraco.AI.Core 18.3.1 requires
         [18.0.0, 18.999.999) and the base package [18.0.0, 19.0.0), so 18.0.0 wins. This pin only has
         to sit at or above that floor.
         Note Umbraco.AI.Core's 18.999.999 ceiling: this package physically cannot install on
         Umbraco 19, whatever the base-package bound says. -->
    <PackageVersion Include="Umbraco.Cms" Version="18.1.1" />
    <!-- TestSite infra. EF Core is pinned to exactly the version Umbraco.Cms 18.1.1 references
         (10.0.10). It must track the host: a lower patch fails restore under
         TreatWarningsAsErrors (NU1605 package downgrade), and a higher one triggers an MSB3277
         assembly-version conflict against Umbraco's own EF Core reference. Bump this in step
         with the Umbraco.Cms pin above. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />
    <!-- Build / versioning — tooling tracks the v18 base repo. -->
    <PackageVersion Include="MinVer" Version="7.0.0" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.300" />
    <!-- Testing — tooling tracks the v18 base repo. -->
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <PackageVersion Include="Umbraco.TheStarterKit" Version="18.0.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
</Project>
