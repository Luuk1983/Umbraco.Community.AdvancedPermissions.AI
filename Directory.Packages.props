<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Base package — the AI companion augments it and resolves its services at runtime.
         Real dependency (flows Abstractions transitively for the compile-time contract). Pinned to
         the v17 line with a PLAIN stable upper bound: a "-0" bound packs fine but nuget.org rejects
         it at push time (400 BadRequest: invalid Version: '18.0.0-0'), and the published base
         package's own nuspec uses plain "[17.3.0, 18.0.0)" bounds — that is the proven form. -->
    <PackageVersion Include="Umbraco.Community.AdvancedPermissions" Version="[17.2.0,18.0.0)" />
    <!-- Umbraco AI — the runtime. The package references Umbraco.AI.Startup, which registers Umbraco
         AI's services and flows Umbraco.AI.Core (the [AITool]/[AIToolScope] attributes,
         IRuntimeContextContributor, the AIRuntimeContextContributors() builder extension) and the
         Umbraco.Cms.* contracts transitively.
         It must NOT be Umbraco.AI.Core alone: Core ships AIContextPickerPropertyValueConverter, which
         Umbraco type-scans and registers, and which needs IAIContextService — registered only by
         Startup's composer. A site with Core but no runtime fails to boot in Development (DI
         validation). Umbraco.AI.Agent depends on Startup for the same reason.
         Not the Umbraco.AI meta package: that also pins Umbraco.AI.Web.StaticAssets, and with NuGet's
         lowest-applicable resolution our floor would hold the backoffice UI at 17.0.0 while another
         package lifts the runtime — a UI/API mismatch. The UI stays a HOST concern (README).
         Realigned to the CMS major in the 2026.06 releases, so 17.0.0 targets Umbraco.Cms 17.x.
         Capped below 18 like the base-package pin: Umbraco.AI majors track the CMS major, so an
         uncapped floor would claim v18 compatibility this v17-targeting package cannot honour.
         Umbraco.AI (meta)/Agent/providers/Copilot are TestSite-only (manual verification). -->
    <PackageVersion Include="Umbraco.AI.Startup" Version="[17.0.0,18.0.0)" />
    <PackageVersion Include="Umbraco.AI" Version="17.2.0" />
    <PackageVersion Include="Umbraco.AI.Agent" Version="17.0.0" />
    <PackageVersion Include="Umbraco.AI.Agent.Copilot" Version="17.0.1" />
    <PackageVersion Include="Umbraco.AI.Anthropic" Version="17.0.2" />
    <PackageVersion Include="Umbraco.AI.OpenAI" Version="17.0.0" />
    <!-- Umbraco CMS meta — TestSite only (CPM requires a version for the direct reference). The
         package project declares NO direct Umbraco.Cms.* references — they flow transitively, and the
         real floor is computed from the dependencies' nuspecs: Umbraco.AI.Startup 17.0.0 (the version
         our floor resolves to) requires [17.4.0, 17.999.999) and the base package [17.3.0, 18.0.0),
         so 17.4.0 wins. This pin only has to sit at or above that floor.
         Note Umbraco.AI's 17.999.999 ceiling: this package physically cannot install on
         Umbraco 18, whatever the base-package bound says. -->
    <PackageVersion Include="Umbraco.Cms" Version="17.5.3" />
    <!-- TestSite infra -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.6" />
    <!-- Build / versioning — tooling tracks the v18 base repo, NOT the v17 Umbraco line. -->
    <PackageVersion Include="MinVer" Version="7.0.0" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.300" />
    <!-- Testing — tooling tracks the v18 base repo. -->
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <PackageVersion Include="Umbraco.TheStarterKit" Version="17.0.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
</Project>